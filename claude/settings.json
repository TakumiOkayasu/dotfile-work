{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "false",
    "EDITOR": "zed --wait",
    "VISUAL": "zed --wait"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "WebFetch"
    ],
    "deny": [
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.env)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(rm -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/docker-build-check.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/language-version-check.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/local-command-block.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/admin-command-block.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/secret-leak-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/env-file-protect.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/main-branch-code-warning.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/commit-checkpoint.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-cleanup-notes-archive.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/primary-source-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/sycophancy-check.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/completion-claim-check.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/failure-log.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-compact-backup.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start-reminder.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-resume.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/project-environment-check.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/vendor-skills-update.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/primary-source-reminder.sh"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start-notes-loader.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "git@github.com:anthropics/claude-plugins-official.git"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "$HOME/.claude/plugins/data",
        "$HOME/.codex"
      ]
    }
  },
  "defaultMode": "auto",
  "effortLevel": "medium",
  "fallbackModel": [],
  "switchModelsOnFlag": false,
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
